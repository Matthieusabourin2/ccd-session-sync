<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ccd-session-sync.org-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__BIN__/ccd-org-sync</string>
        <string>sync</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CCD_PAIR</key>
        <string>__PAIR__</string>
        <key>CCD_QUIET_MAX_WAIT</key>
        <string>120</string>
    </dict>
    <key>WatchPaths</key>
    <array>
        <string>__ORG_A__</string>
        <string>__ORG_B__</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__BACKUPS__/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__BACKUPS__/launchd.log</string>
</dict>
</plist>
