#!/usr/bin/env python3
"""ccd-org-sync — keep the Claude Desktop Code sidebar identical across two orgs of ONE account
(e.g. Personal/Max and a Team org), switched with the app's native org switcher.

Desktop keeps one sidebar index per org:
  ~/Library/Application Support/Claude/claude-code-sessions/<account>/<org>/local_<uuid>.json
Transcripts live org-agnostically in ~/.claude/projects and are never touched here.
Observed (Desktop 2.7032, re-checked 2.19675): the app re-reads the index on every org switch and only writes the
ACTIVE org's dir, so merging entries into the other dir makes them appear on the next switch.
One entry that Desktop rewrites while we work is deferred to the next run; the others still go through.
Scheduled tasks work the same way (scheduled-tasks.json per org): the active org's list is mirrored
into the inactive org's file, so the tasks keep running whichever org is active.

  ccd-org-sync sync [--dry-run] [--only <sessionId>] [--verbose] [--allow-bulk]
  ccd-org-sync status
  ccd-org-sync rollback <snapshot-ts>
  ccd-org-sync unblock
Pair (required): CCD_PAIR="MAX=<acct>/<org>,TEAM=<acct>/<org>"  (or --pair)

Lesson (Catalia R1 triage, 20/10/2026; brain: apprentissages/etat-claude-desktop-par-org-perdu-a-la-bascule-max-team):
treat every Max <-> Team switch as a migration, not an account change. This script only carries the
sidebar and the scheduled tasks. Skills, MCP connectors and OAuth clients are attached to each org and
are lost silently. After each switch, check end to end: sidebar, scheduled tasks, skills, connectors
(gbrain needs a confidential OAuth client on Team).
"""
import fcntl, glob, hashlib, json, os, re, shutil, subprocess, sys, time
from datetime import datetime

ROOT = os.environ.get('CCD_CLAUDE_DIR', os.path.expanduser('~/Library/Application Support/Claude'))
PROJECTS = os.environ.get('CCD_PROJECTS_DIR', os.path.expanduser('~/.claude/projects'))
BK = os.environ.get('CCD_BACKUP_DIR', os.path.expanduser('~/.claude/ccd-session-sync-backups'))
QUIET = float(os.environ.get('CCD_QUIET_SECONDS', '15'))
QUIET_MAX_WAIT = float(os.environ.get('CCD_QUIET_MAX_WAIT', '180'))
KEEP = int(os.environ.get('CCD_KEEP_SNAPSHOTS', '200'))
MAX_CREATE = int(os.environ.get('CCD_MAX_CREATE', '25'))
CCS = os.path.join(ROOT, 'claude-code-sessions')
BLOCKED = os.path.join(BK, 'BLOCKED')
CONFLICTS = os.path.join(BK, 'CONFLICTS')
LOG = os.path.join(BK, 'sync.log')
# app files whose mtime (never content) tells us Desktop is busy; config.json holds the OAuth cache
BUSY_FILES = ['config.json', 'mcp-user-tool-toggles.json', 'plan-usage-history.json']
# Desktop rewrites many fields without touching lastActivityAt/lastFocusedAt (observed: prs on 2.7032;
# isStarred, publishedArtifacts, peerReceipts, planPath on 2.19675). At equal version the file Desktop
# wrote last wins; it only writes the active org and we propagate within seconds, so sides rarely diverge.
# the title is merged on its own: a rename does not bump lastActivityAt, so it must not be lost to
# newer activity in the other org. previousTitles (rename history) decides; else human > automatic.
TITLE_FIELDS = {'title', 'titleSource', 'titleTurn', 'previousTitles'}
HUMAN_TITLE = {'user', 'tool'}
# Scheduled tasks (Desktop 2.19675): one scheduled-tasks.json per org, read only when the org loads
# (launch or switch) and rewritten whole from memory, for the ACTIVE org only. Only the active org runs
# tasks, so we mirror the active org's list into the inactive org's file and never write the active one.
# An index entry is huge: median 540 KB over 1 434 files, 662 MB in all (measured 2026-11-05),
# because Desktop copies the whole MCP config into every one — remoteMcpServersConfig 83 %,
# enabledMcpTools 15 %, promptAppendSnapshot 2 %. None of the three is read here, yet json.loads was
# 52 s of the ~56 s a pass costs. So a pass now stats every file and parses only the few that can
# produce an op; the rest is answered from a cache keyed on (mtime_ns, size).
# The cache only ever RULES WORK OUT. It never feeds a write: a real merge serializes the object
# (plan(), 'json.dumps(merged)'), so a projection reaching that path would silently drop those keys.
# A hit rests entirely on (mtime_ns, size) telling two versions of a file apart. Nanosecond mtimes
# make that safe here — an apply() write of rigorously identical size was still 466 us away — but it
# is the one assumption the whole scheme leans on. Bump CACHE_FORMAT whenever PROJ_FIELDS changes or
# parse_entry gets stricter: entries already cached would otherwise escape the new validation.
CACHE = os.path.join(BK, 'index-cache.json')
CACHE_FORMAT = 1
PROJ_FIELDS = ('cliSessionId', 'scheduledTaskId')  # all a skip decision needs; never written out
# A projection is trusted without reading the file, so a cache that is valid but WRONG — something
# no code path here can write, since proj and sha always come from the same bytes — would keep a
# live session out of the other org. Validation cannot catch that: the lie is well-formed. So the
# whole cache is dropped once a day and rebuilt from the files. It costs one cold pass, and it is
# why no mistake in here can hide a session for longer than that.
CACHE_TTL = float(os.environ.get('CCD_CACHE_TTL', 86400))
TASKS = 'scheduled-tasks.json'
TASKS_HELD = os.path.join(BK, 'TASKS_HELD')
LOGS = os.environ.get('CCD_DESKTOP_LOGS', os.path.expanduser('~/Library/Logs/Claude'))
MAX_TASK_DELETE = int(os.environ.get('CCD_MAX_TASK_DELETE', '2'))
RUN_FIELDS = ('lastRunAt', 'lastScheduledFor', 'missedRunScanFloor')  # newer side wins if same schedule
SCHEDULE_FIELDS = ('cronExpression', 'fireAt')
TASK_FLAGS = ('sundayAliasBoundaryStamped', 'dayFieldsOrBoundaryStamped')


class Abort(Exception):
    pass


class Blocked(Abort):
    pass


def log(msg):
    os.makedirs(BK, exist_ok=True)
    with open(LOG, 'a') as f:
        f.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {msg}\n")


def notify(title, msg):
    if os.environ.get('CCD_NO_NOTIFY'):
        return
    subprocess.run(['/usr/bin/osascript', '-e', f'display notification "{msg}" with title "{title}"'],
                   capture_output=True)


def sha(b):
    return hashlib.sha256(b).hexdigest()


def desktop_version():
    try:
        out = subprocess.run(['defaults', 'read', '/Applications/Claude.app/Contents/Info.plist',
                              'CFBundleShortVersionString'], capture_output=True, text=True)
        return out.stdout.strip() or 'unknown'
    except Exception:
        return 'unknown'


def parse_pair(spec):
    if not spec:
        raise Abort('no org pair configured (CCD_PAIR="MAX=<acct>/<org>,TEAM=<acct>/<org>")')
    pair = {}
    for part in spec.split(','):
        label, _, rel = part.partition('=')
        if not label or rel.count('/') != 1:
            raise Abort(f'bad pair element: {part!r}')
        pair[label.strip()] = rel.strip()
    if len(pair) != 2:
        raise Abort('pair must name exactly 2 orgs')
    (la, ra), (lb, rb) = pair.items()
    if ra.split('/')[0] != rb.split('/')[0] or ra == rb:
        raise Abort('both orgs must belong to the same account and differ')
    return [(la, os.path.join(CCS, ra)), (lb, os.path.join(CCS, rb))]


def check_owner(pair):
    acct = os.path.basename(os.path.dirname(pair[0][1]))
    try:
        owner = json.load(open(os.path.join(ROOT, 'cowork-enabled-cli-ops.json')))['ownerAccountId']
    except Exception as e:
        raise Abort(f'cannot read ownerAccountId ({type(e).__name__})')
    if owner != acct:
        raise Abort(f'logged-in account {owner[:8]} is not the paired account {acct[:8]} — refusing')
    for label, d in pair:
        if not os.path.isdir(d):
            raise Abort(f'{label} index dir missing: {d}')


def newest_activity(pair):
    ts = [os.path.getmtime(d) for _, d in pair]
    for _, d in pair:
        ts += [os.path.getmtime(f) for f in glob.glob(os.path.join(d, 'local_*.json'))]
    for p in [os.path.join(ROOT, f) for f in BUSY_FILES] + [os.path.join(d, TASKS) for _, d in pair]:
        if os.path.exists(p):
            ts.append(os.path.getmtime(p))
    return max(ts)


def wait_quiet(pair):
    deadline = time.time() + QUIET_MAX_WAIT
    while True:
        idle = time.time() - newest_activity(pair)
        if idle >= QUIET:
            return
        if time.time() > deadline:
            raise Abort(f'Desktop never went quiet for {QUIET:.0f}s — retry later')
        time.sleep(min(QUIET - idle, 5) + 0.2)


def read_paired(f):
    """-> (bytes, stat) that describe the same file version. Desktop may write while we read, and a
    stat taken after the read would then describe bytes we never saw — deferral would miss it.
    When the file will not sit still, we return the stat from BEFORE the last read: it is older than
    the file as it now stands, so it can only cause a cache miss or a deferral, never a false hit.
    Returning the one from after would claim these bytes are current, which is the bug this avoids:
    moved_since would see nothing to defer, and the cache would hold a new stat with old bytes."""
    raw, st_before = b'', None
    for _ in range(3):
        st = os.stat(f)
        raw = open(f, 'rb').read()
        st2 = os.stat(f)
        if (st2.st_mtime_ns, st2.st_size) == (st.st_mtime_ns, st.st_size):
            return raw, st
        st_before = st
    return raw, st_before


def parse_entry(raw, stem):
    try:
        obj = json.loads(raw)
    except ValueError:
        raise Abort(f'invalid JSON in {stem}.json — unknown format, no writes')
    if not isinstance(obj, dict) or obj.get('sessionId') != stem \
            or not isinstance(obj.get('lastActivityAt'), int) or not isinstance(obj.get('cwd'), str) \
            or not isinstance(obj.get('cliSessionId'), (str, type(None))) \
            or not isinstance(obj.get('scheduledTaskId'), (str, type(None))):
        # the last two decide whether a one-sided entry is copied at all. Left untyped, a list there
        # reached `not in tx` as an unhashable key and killed the pass with a bare TypeError.
        raise Abort(f'unexpected schema in {stem}.json — no writes')
    return obj


def skip_reason(o, tx):
    """why this one-sided entry must not be copied, or None. Judged first on the cached projection,
    to spare a read, then AGAIN on the object actually read: the projection describes the file as it
    stood at the phase-1 stat, and Desktop may have added one of these fields since."""
    if o.get('cliSessionId') not in tx:
        return 'dead_skipped'
    if o.get('scheduledTaskId'):     # automated runs of an org's own scheduled tasks
        return 'scheduled_task_skipped'
    return None


class Entry:
    """one index file. Cheap by default — a stat, plus sha and projection from the cache; the bytes
    are read and parsed only when a decision or a write actually needs the whole object."""
    __slots__ = ('path', 'stem', 'st', 'sha', 'proj', '_full')

    def __init__(self, path, stem, st, sha_, proj, full=None):
        self.path, self.stem, self.st, self.sha, self.proj, self._full = path, stem, st, sha_, proj, full

    def full(self):
        """-> (bytes, obj, stat). Reads and validates now if the cache has answered so far, and
        re-pairs st/sha/proj with the bytes just read, so the cache we save stays self-consistent."""
        if self._full is None:
            if os.environ.get('CCD_TEST_UNLINK_BEFORE_FULL') == self.stem:
                os.unlink(self.path)   # tests only: Desktop removing an entry mid-pass
            raw, st = read_paired(self.path)
            obj = parse_entry(raw, self.stem)
            self._full = (raw, obj, st)
            self.st, self.sha = st, sha(raw)
            self.proj = {k: obj.get(k) for k in PROJ_FIELDS}
        return self._full


def load_cache():
    """-> {path: [mtime_ns, size, sha, proj]}. Anything unreadable, stale or odd means a cold pass:
    the cache may cost speed, never correctness, and must never abort a run."""
    try:
        c = json.load(open(CACHE))
        if c.get('format') != CACHE_FORMAT or c.get('proj_fields') != sorted(PROJ_FIELDS):
            return {}
        if not isinstance(c.get('written_at'), (int, float)) \
                or time.time() - c['written_at'] > CACHE_TTL:
            return {}   # too old (or undated): rebuild from the files
        out = {}
        for path, v in (c.get('files') or {}).items():
            if not (isinstance(v, list) and len(v) == 4 and isinstance(v[0], int)
                    and isinstance(v[1], int) and isinstance(v[2], str) and isinstance(v[3], dict)):
                continue
            # the projection's VALUES matter as much as its shape. A list or dict here reached
            # `not in tx` as an unhashable key: TypeError inside plan(), outside any try. And since
            # that fires before save_cache(), the bad cache was never rewritten — the pass died
            # every 5 minutes for good, over index files that were perfectly valid.
            if set(v[3]) != set(PROJ_FIELDS) or not all(
                    isinstance(x, (str, type(None))) for x in v[3].values()):
                continue
            out[path] = v
        return out
    except Exception:
        return {}


def save_cache(fresh):
    try:
        body = {'format': CACHE_FORMAT, 'proj_fields': sorted(PROJ_FIELDS),
                'written_at': time.time(), 'files': fresh}
        data = json.dumps(body).encode()
        atomic_write(CACHE, data, sha(data))
    except Exception:
        pass  # a cache we cannot write is a slow next pass, not a failed one


def load_org(d, cache, counts):
    """-> (entries{sid: Entry}, tombstones{sid})"""
    entries, tomb = {}, set()
    for f in glob.glob(os.path.join(d, 'deleted_*')):
        tomb.add(os.path.basename(f)[len('deleted_'):])
    for f in glob.glob(os.path.join(d, 'local_*.json')):
        stem = os.path.basename(f)[:-len('.json')]
        st = os.stat(f)
        hit = cache.get(f)
        if hit and hit[0] == st.st_mtime_ns and hit[1] == st.st_size:
            counts['cache_hit'] += 1
            entries[stem] = Entry(f, stem, st, hit[2], hit[3])
        else:  # new or rewritten: read it, validate it, and let it refill the cache
            counts['cache_miss'] += 1
            raw, st = read_paired(f)
            obj = parse_entry(raw, stem)
            # deliberately NOT kept as `full`: holding the bytes and the parsed object of every
            # entry meant ~660 MB of bytes and several GB of dicts at once, and a cold pass spent
            # its time swapping. The few candidates are read again in phase 2, which costs a
            # handful of reads and keeps peak memory at one entry.
            entries[stem] = Entry(f, stem, st, sha(raw), {k: obj.get(k) for k in PROJ_FIELDS})
    return entries, tomb


def version(obj):
    lf = obj.get('lastFocusedAt')
    return (obj['lastActivityAt'], lf if isinstance(lf, int) else 0)


def title_group(o):
    return {k: o[k] for k in TITLE_FIELDS if k in o}


def title_winner(x, y):
    """which entry's title group is the latest intent: 'x', 'y', 'entry' (no preference) or None."""
    if title_group(x) == title_group(y):
        return 'entry'
    px, py = x.get('previousTitles') or [], y.get('previousTitles') or []
    xy, yx = x.get('title') in py, y.get('title') in px   # "y was renamed from x's title", and vice versa
    if xy and yx:  # both histories cite the other (a rename was undone): the longer, extending history wins
        if len(py) > len(px) and py[:len(px)] == px:
            return 'y'
        if len(px) > len(py) and px[:len(py)] == py:
            return 'x'
        return None
    if xy or yx:
        return 'y' if xy else 'x'
    ux, uy = x.get('titleSource') in HUMAN_TITLE, y.get('titleSource') in HUMAN_TITLE
    if ux != uy:
        return 'x' if ux else 'y'       # a chosen title beats an automatic one
    return 'entry' if not ux else None  # two different chosen titles, no history: ambiguous


def merge(a, b):
    """-> (merged_obj, mtime_tiebreak_used) or None when ambiguous (conflict)."""
    x, y = a[1], b[1]
    tw = title_winner(x, y)
    if tw is None:
        return None
    va, vb = version(x), version(y)
    bg, same_version = 0, va == vb
    if same_version:
        rest = {k for k in set(x) | set(y) if x.get(k) != y.get(k)} - TITLE_FIELDS
        if rest:  # rewrite without version bump: the newer file is the latest Desktop write
            if a[2] is None or b[2] is None or a[2].st_mtime_ns == b[2].st_mtime_ns:
                return None
            va, vb, bg = a[2].st_mtime_ns, b[2].st_mtime_ns, 1
    if same_version and tw == 'entry' and title_group(x) != title_group(y):
        return None  # equal version, two different automatic titles: no reliable winner
    base = dict(x if va >= vb else y)
    if tw != 'entry':
        src = x if tw == 'x' else y
        for k in TITLE_FIELDS:
            base.pop(k, None)
        base.update(title_group(src))
    return base, bg


def plan(pair, only=None):
    (la, da), (lb, db) = pair
    cache, counts = load_cache(), dict.fromkeys(['cache_hit', 'cache_miss'], 0)
    ea, ta = load_org(da, cache, counts)
    eb, tb = load_org(db, cache, counts)
    tomb = ta | tb
    tx = {os.path.basename(f)[:-len('.jsonl')] for f in glob.glob(os.path.join(PROJECTS, '*', '*.jsonl'))}
    ops, conflicts = [], []
    c = dict.fromkeys(['common_identical', 'tombstone_skipped', 'dead_skipped', 'scheduled_task_skipped',
                       'background_refresh', 'vanished_skipped'], 0)
    cat = dict.fromkeys(['archived', 'scheduled_task', 'scratch_cwd', 'worktree_cwd'], 0)
    ids = set(ea) | set(eb)
    if only:
        ids &= {only}
        if not ids:
            raise Abort(f'--only {only}: no such session in either org')
    for sid in sorted(ids):
        if sid[len('local_'):] in tomb:
            c['tombstone_skipped'] += 1
            continue
        a, b = ea.get(sid), eb.get(sid)
        if a and b:
            if a.sha == b.sha:  # identical bytes: the cache answers this without reading either file
                c['common_identical'] += 1
                continue
            try:
                af, bf = a.full(), b.full()  # candidate: we work on the real objects from here on
            except OSError:   # Desktop deleted it between the phase-1 scan and now. One entry it
                c['vanished_skipped'] += 1   # removes under us must not stop all the others.
                continue
            if af[1] == bf[1]:           # same object, different bytes (key order, indent)
                c['common_identical'] += 1
                continue
            res = merge(af, bf)
            if res is None:
                conflicts.append(sid)
                continue
            merged, bg = res
            c['background_refresh'] += bg
            # write the merged entry to every side that differs from it (usually just the older one)
            data = af[0] if merged == af[1] else bf[0] if merged == bf[1] else json.dumps(merged).encode()
            m = (data, merged, None)
            if af[1] != merged:
                ops.append(('UPD', lb if merged == bf[1] else 'MERGE', la, da, sid, m, af))
            if bf[1] != merged:
                ops.append(('UPD', la if merged == af[1] else 'MERGE', lb, db, sid, m, bf))
            continue
        else:
            s = a or b
            why = skip_reason(s.proj, tx)   # ruled out on the projection alone: no read, no parse
            if why:
                c[why] += 1
                continue
            try:
                sf = s.full()
            except OSError:
                c['vanished_skipped'] += 1
                continue
            if (why := skip_reason(sf[1], tx)):   # judge again on the bytes we actually read
                c[why] += 1
                continue
            op = ('NEW', la, lb, db, sid, sf, None) if a else ('NEW', lb, la, da, sid, sf, None)
        o = op[5][1]
        cat['archived'] += bool(o.get('isArchived'))
        cat['scheduled_task'] += bool(o.get('scheduledTaskId'))
        cat['scratch_cwd'] += '/scratch-workspaces/' in o.get('cwd', '')
        cat['worktree_cwd'] += '/.claude/worktrees/' in o.get('cwd', '')
        ops.append(op)
    stats = {la: len(ea), lb: len(eb), 'common': len(set(ea) & set(eb)),
             f'{la}_only': len(set(ea) - set(eb)), f'{lb}_only': len(set(eb) - set(ea)),
             'conflicts': len(conflicts), **c, 'to_create': sum(o[0] == 'NEW' for o in ops),
             'to_update': sum(o[0] == 'UPD' for o in ops), 'categories_of_writes': cat, **counts}
    ids_w = {o[4] for o in ops}
    seen = {}  # {sid: {path: stat}} — an op depends on its own entry only, in either org
    for d, e in ((da, ea), (db, eb)):
        for sid in ids_w & set(e):
            seen.setdefault(sid, {})[os.path.join(d, sid + '.json')] = e[sid].st
    # saved last, so an entry full() re-read carries the stat paired with the bytes we just used
    save_cache({e.path: [e.st.st_mtime_ns, e.st.st_size, e.sha, e.proj]
                for e in list(ea.values()) + list(eb.values())})
    return ops, conflicts, stats, seen


def active_org(pair):
    """label of the org whose tasks Desktop holds in memory: the last CCD scheduler init in its log.
    None while a switch is in progress or when the log says nothing: tasks are then left alone."""
    ids = {os.path.basename(d): label for label, d in pair}
    for name in ('main.log', 'main1.log'):  # main.log rotates into main1.log
        try:
            lines = open(os.path.join(LOGS, name), errors='replace').read().splitlines()
        except OSError:
            continue
        for line in reversed(lines):
            if '[CCDScheduledTasks] Reset' in line:
                return None
            m = re.search(r"\[CCDScheduledTasks\] Initialized \{.*orgId: '([0-9a-f-]+)'", line)
            if m:
                return ids.get(m.group(1))
    return None


def when(v):
    """Desktop's ISO time ('…Z') -> epoch seconds; the agent's /usr/bin/python3 (3.9) rejects a bare 'Z'."""
    try:
        return datetime.fromisoformat(v[:-1] + '+00:00' if v.endswith('Z') else v).timestamp()
    except (AttributeError, TypeError, ValueError):
        return float('-inf')


def read_tasks(p):
    """-> (bytes, obj, stat), or None when the file does not exist."""
    if not os.path.exists(p):
        return None
    st = os.stat(p)
    raw = open(p, 'rb').read()
    try:
        obj = json.loads(raw)
    except ValueError:
        raise Abort(f'invalid JSON in {TASKS} — unknown format, tasks left alone')
    ts = obj.get('scheduledTasks') if isinstance(obj, dict) else None
    if not isinstance(ts, list) or not all(isinstance(t, dict) and isinstance(t.get('id'), str) for t in ts):
        raise Abort(f'unexpected schema in {TASKS} — tasks left alone')
    return raw, obj, st


def cron_field(spec, v, lo, hi):
    for part in spec.split(','):
        rng, _, step = part.partition('/')
        if rng == '*':
            a, b = lo, hi
        elif '-' in rng:
            a, b = map(int, rng.split('-'))
        else:
            a = b = int(rng)
            if step:
                b = hi
        if a <= v <= b and (v - a) % int(step or 1) == 0:
            return True
    return False


def cron_match(expr, t):
    mi, h, dom, mon, dow = expr.split()
    wd = (t.weekday() + 1) % 7  # cron: Sunday = 0 (or 7)
    d1 = cron_field(dom, t.day, 1, 31)
    d2 = cron_field(dow, wd, 0, 7) or (wd == 0 and cron_field(dow, 7, 0, 7))
    day = (d1 or d2) if dom != '*' and dow != '*' else (d1 and d2)
    return day and cron_field(mi, t.minute, 0, 59) and cron_field(h, t.hour, 0, 23) \
        and cron_field(mon, t.month, 1, 12)


def catch_ups(tasks, now):
    """ids Desktop runs as soon as it loads this list: its missed-run scan finds the latest slot after
    the last run, at most 7 days back, and runs it once; a past one-time task that never ran also fires."""
    out = []
    for t in tasks:
        if not t.get('enabled'):
            continue
        if t.get('fireAt') is not None:
            if t['fireAt'] <= now * 1000 and not t.get('lastRunAt'):
                out.append(t['id'])
            continue
        last = when(t.get('lastScheduledFor') or t.get('lastRunAt'))
        floor = max(last if last > float('-inf') else t.get('createdAt', 0) / 1000, now - 7 * 86400,
                    when(t.get('missedRunScanFloor')))
        skip = int(last // 60) if last > float('-inf') else None
        m = int(now // 60) - 1
        try:
            while m * 60 > floor:
                if m != skip and cron_match(t['cronExpression'], datetime.fromtimestamp(m * 60)):
                    out.append(t['id'])
                    break
                m -= 1
        except (KeyError, ValueError, AttributeError):
            out.append(f'{t["id"]} (unreadable schedule)')
    return out


def plan_tasks(pair, allow_bulk=False, preview=False):
    """-> (op | None, info, seen): mirror the active org's tasks into the inactive org's file.
    Which tasks exist and their settings come from the active org; per task with an unchanged schedule,
    the run state never moves backwards. The inactive org's retries are dropped: a retry is a run."""
    act = active_org(pair)
    if act is None:
        return None, {'tasks': 'active org unknown or switching — left alone'}, {}
    (sl, sdir), (dl, ddir) = pair if pair[0][0] == act else pair[::-1]
    sp, dp = os.path.join(sdir, TASKS), os.path.join(ddir, TASKS)
    s, d = read_tasks(sp), read_tasks(dp)
    if s is None:
        return None, {'tasks': f'{sl} has no {TASKS} — left alone'}, {}
    old = {t['id']: t for t in d[1]['scheduledTasks']} if d else {}
    out = []
    for t in s[1]['scheduledTasks']:
        o, prev = dict(t), old.get(t['id'])
        if prev and all(prev.get(f) == t.get(f) for f in SCHEDULE_FIELDS):
            for f in RUN_FIELDS:
                if when(prev.get(f)) > when(o.get(f)):
                    o[f] = prev[f]
        out.append(o)
    new = {'scheduledTasks': out, 'recordedSkips': (d[1].get('recordedSkips') if d else None) or {}}
    for k in TASK_FLAGS:
        if s[1].get(k) or (d and d[1].get(k)):
            new[k] = True
    data = json.dumps(new, indent=2, ensure_ascii=False).encode()  # Desktop's own serialization
    removed = sorted(set(old) - {t['id'] for t in out})
    info = {'tasks_active': sl, 'tasks_written_to': dl, f'tasks_{sl}': len(out), f'tasks_{dl}': len(old),
            'tasks_added': sorted({t['id'] for t in out} - set(old)), 'tasks_removed': removed}
    if not out and old:
        info['tasks_held'] = f'{sl} has 0 scheduled tasks but {dl} has {len(old)} — not mirrored'
    elif len(removed) > MAX_TASK_DELETE and not allow_bulk:
        info['tasks_held'] = (f'would remove {len(removed)} tasks from {dl} (cap {MAX_TASK_DELETE}) — '
                              f'review a dry-run, then sync --allow-bulk')
    if preview:
        loaded = list(old.values()) if 'tasks_held' in info else out
        info[f'tasks_run_at_once_on_switch_to_{dl}'] = catch_ups(loaded, time.time())
    if 'tasks_held' in info or (d and data == d[0]):
        return None, info, {}
    op = ('UPD' if d else 'NEW', sl, dl, ddir, TASKS[:-len('.json')], (data, new, None), d)
    return op, info, {TASKS[:-len('.json')]: {sp: s[2], **({dp: d[2]} if d else {})}}


def moved_since(sid, seen):
    """name of the first file this op was planned against that is no longer what we read, else None."""
    for p, st in seen.get(sid, {}).items():
        try:  # gone between the check and the stat is still 'moved': defer it, never crash the run
            now = os.stat(p)
        except OSError:
            return os.path.basename(p)[:20]
        if (now.st_mtime_ns, now.st_size) != (st.st_mtime_ns, st.st_size):
            return os.path.basename(p)[:20]
    return None


def apply(ops, pair, seen):
    """-> (snapshot timestamp, the ops actually written). An entry Desktop rewrote meanwhile is
    deferred to the next run and never holds back the others."""
    hook = os.environ.get('CCD_TEST_TOUCH_BEFORE_APPLY')  # test hook: Desktop rewrites entries meanwhile
    if hook:
        paths = [p for v in seen.values() for p in v]
        for p in (paths if hook == 'all' else paths[:1]):
            if hook == 'rm':
                os.remove(p)
            else:
                os.utime(p, ns=(time.time_ns() + 10**9, time.time_ns() + 10**9))
    kept, deferred = [], []
    for op in ops:
        m = moved_since(op[4], seen)
        if m:
            deferred.append(m)
        else:
            kept.append(op)
    if deferred:
        log(f'deferred {len(deferred)} entry(ies) changed during sync ({deferred[0]})')
    if not kept:
        raise Abort(f'all {len(deferred)} entry(ies) changed during sync — retry later')
    ops = kept
    # monotonic suffix: cmd_sync calls apply() twice (tasks, then sidebar); same second + same
    # pid once collided on the snapshot dir, and the FileExistsError killed the sidebar sync.
    ts = time.strftime('%Y%m%d-%H%M%S') + f'-{os.getpid()}-{time.monotonic_ns() % 10**6:06d}'
    snap = os.path.join(BK, ts)
    os.makedirs(os.path.join(snap, 'files'))
    man = {'timestamp': ts, 'claude_desktop_version': desktop_version(), 'status': 'in-progress',
           'pair': {l: os.path.relpath(d, CCS) for l, d in pair}, 'ops': []}
    for kind, sl, dl, ddir, sid, s, d in ops:
        dst = os.path.join(ddir, sid + '.json')
        rec = {'op': kind, 'source_space': sl, 'destination_space': dl, 'path': dst,
               'sha256_after': sha(s[0]), 'sha256_before': sha(d[0]) if d else None}
        if d:
            bpath = os.path.join(snap, 'files', dl, sid + '.json')
            os.makedirs(os.path.dirname(bpath), exist_ok=True)
            with open(bpath, 'wb') as f:
                f.write(d[0]); f.flush(); os.fsync(f.fileno())
            rec['backup'] = os.path.relpath(bpath, snap)
        man['ops'].append(rec)
    write_manifest(snap, man)
    if os.environ.get('CCD_TEST_TOUCH_DEST_BEFORE_WRITE'):  # test hook: Desktop writes the
        for rec in man['ops']:                              # destination inside the CAS window
            if rec['sha256_before'] is not None:
                os.utime(rec['path'], ns=(time.time_ns() + 10**9,) * 2)
    crash_after = int(os.environ.get('CCD_TEST_CRASH_AFTER', '-1'))
    try:
        _apply_ops(ops, man, crash_after, snap)
    except Abort:
        man['status'], man['applied'] = 'aborted', man.get('applied', 0)
        write_manifest(snap, man)
        raise
    man['status'] = 'done'
    write_manifest(snap, man)
    prune()
    return ts, [o for o, rec in zip(ops, man['ops']) if not rec.get('skipped')]


def _apply_ops(ops, man, crash_after, snap):
    done = 0
    for (kind, sl, dl, ddir, sid, s, d), rec in zip(ops, man['ops']):
        dst = rec['path']
        # compare-and-swap: the destination must still be exactly what we planned against
        try:
            st = os.stat(dst)
        except OSError:  # gone, or vanished between the check and the stat
            st = None
        stale = (st is not None) if d is None else (
            st is None or (st.st_mtime_ns, st.st_size) != (d[2].st_mtime_ns, d[2].st_size))
        if stale:  # Desktop wrote the destination between plan and apply: leave it to the next run
            rec['skipped'] = True  # not written, so rollback must ignore it
            write_manifest(snap, man)  # on disk before the next write, so a crash can still roll back
            log(f'skipped {sid[:14]} — changed in {dl} during sync')
            continue
        atomic_write(dst, s[0], rec['sha256_after'])
        done += 1
        man['applied'] = done
        if done == crash_after:
            os._exit(9)  # test hook: simulate a kill mid-run
    return done


def atomic_write(dst, data, expect_sha):
    """hidden temp in the same dir -> fsync -> verify -> rename; the temp never survives."""
    tmp = os.path.join(os.path.dirname(dst), f'.ccdsync-{os.getpid()}-{time.monotonic_ns()}.tmp')
    try:
        with open(tmp, 'wb') as f:
            f.write(data); f.flush(); os.fsync(f.fileno())
        if sha(open(tmp, 'rb').read()) != expect_sha:
            raise Abort('temp file verification failed')
        os.replace(tmp, dst)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def write_manifest(snap, man):
    p = os.path.join(snap, 'manifest.json')
    tmp = p + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(man, f, indent=1); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)


def prune():
    """prune completed and no-op aborted snapshots; in-progress / partial / rolled-back / pinned are kept."""
    done = []
    for d in sorted(os.listdir(BK)):
        m = os.path.join(BK, d, 'manifest.json')
        if os.path.exists(os.path.join(BK, d, 'PINNED')):  # e.g. the initial bulk migration
            continue
        try:
            mf = json.load(open(m))
            if mf.get('status') == 'done' or (mf.get('status') == 'aborted' and not mf.get('applied')):
                done.append(d)
        except (OSError, ValueError):
            pass
    for d in done[:-KEEP]:
        shutil.rmtree(os.path.join(BK, d))


def lock():
    """one sync or rollback at a time (held until the process exits)."""
    fd = os.open(os.path.join(BK, 'lock'), os.O_CREAT | os.O_RDWR, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def check_blocked():
    if os.path.exists(BLOCKED):
        raise Blocked(f'blocked ({open(BLOCKED).read().strip()}) — fix, then `ccd-org-sync unblock`')


def report_once(path, cur, title, msg):
    """log + notify once per distinct state (the agent runs every few minutes)."""
    if os.path.exists(path) and open(path).read() == cur:
        return
    with open(path, 'w') as f:
        f.write(cur)
    log(msg)
    notify(title, msg)


def sync_tasks(args, pair, dry):
    """scheduled tasks, on their own: nothing here may stop the sidebar sync, nor the reverse."""
    try:
        op, info, seen = plan_tasks(pair, '--allow-bulk' in args, preview=dry or '--verbose' in args)
    except Abort as e:
        op, info, seen = None, {'tasks_error': str(e)}, {}
    print(json.dumps(info, indent=1, ensure_ascii=False))
    if dry:
        return
    if 'tasks_error' in info:
        report_once(TASKS_HELD, info['tasks_error'], 'ccd-org-sync: tasks', f'tasks {info["tasks_error"]}')
    elif 'tasks_held' in info:
        report_once(TASKS_HELD, info['tasks_held'], 'ccd-org-sync: tasks', f'tasks {info["tasks_held"]}')
    elif os.path.exists(TASKS_HELD) and 'tasks_active' in info:
        os.unlink(TASKS_HELD)
        log('tasks hold cleared')
    if op:
        try:
            ts, _ = apply([op], pair, seen)
            log(f'tasks snapshot={ts} {info["tasks_active"]}->{info["tasks_written_to"]} '
                f'added={len(info["tasks_added"])} removed={len(info["tasks_removed"])} result=ok')
        except Abort as e:
            log(f'tasks ABORT {e}')


def cmd_sync(args, pair):
    dry = '--dry-run' in args
    only = args[args.index('--only') + 1] if '--only' in args else None
    if not dry:
        check_blocked()
    check_owner(pair)
    if not dry:
        lock()
        wait_quiet(pair)
        check_blocked()  # a rollback/abort may have happened while we waited
    if not only:
        sync_tasks(args, pair, dry)
    t0 = time.monotonic()  # the work, not the quiet wait before it
    ops, conflicts, stats, seen = plan(pair, only)
    print(json.dumps(stats, indent=1))
    if '--verbose' in args:
        for kind, sl, dl, _, sid, s, _ in ops:
            print(f'  {kind} {sl}->{dl} {sid[:14]} cwd={s[1]["cwd"]}')
        for sid in conflicts:
            print(f'  CONFLICT {sid[:14]}')
    if conflicts:  # skip only these entries; one ambiguous session must never stall the others
        msg = f'{len(conflicts)} conflict(s) skipped: same version, different content ({conflicts[0][:14]}…)'
        print(f'WARNING: {msg}', file=sys.stderr)
        if not dry and not only:  # an --only run sees one session, not the whole conflict set
            report_once(CONFLICTS, '\n'.join(conflicts), 'ccd-org-sync: conflict', f'sync {msg}')
    elif not dry and not only and os.path.exists(CONFLICTS):
        os.unlink(CONFLICTS)
        log('sync conflicts cleared')
    (la, _), (lb, _) = pair
    guards = []
    if not only and (stats[la] == 0 or stats[lb] == 0):
        guards.append(f'one side is empty ({la}={stats[la]}, {lb}={stats[lb]}) — wrong pair or unknown format')
    if stats['to_create'] > MAX_CREATE and '--allow-bulk' not in args:
        guards.append(f'{stats["to_create"]} creations > cap {MAX_CREATE} — review this dry-run, then sync --allow-bulk')
    if guards and not dry:
        raise Abort('; '.join(guards))
    for g in guards:
        print(f'WARNING (a real run would abort): {g}')
    if dry:
        print('DRY RUN — no session file modified (only the index cache was refreshed)')
        return
    cache_stat = f'cache={stats["cache_hit"]}/{stats["cache_hit"] + stats["cache_miss"]}'
    if not ops:  # logged too: a quiet pass is the one whose cost we care about
        log(f'sync nothing-to-do {cache_stat} took={time.monotonic() - t0:.1f}s result=ok')
        return
    ts, written = apply(ops, pair, seen)
    nc = sum(o[0] == 'NEW' for o in written)
    nu = len(written) - nc
    log(f'sync snapshot={ts} created={nc} updated={nu} '
        f'deferred={len(ops) - len(written)} {cache_stat} took={time.monotonic() - t0:.1f}s result=ok')
    print(f'snapshot {ts}: created={nc} updated={nu}')
    # Desktop reads an org's index on launch and on switch only: a new entry written into the org it
    # already holds stays invisible until then. Say so, rather than let the session look lost.
    act = active_org(pair)
    blind = sum(1 for o in written if o[0] == 'NEW' and o[2] == act)
    if blind:
        notify('ccd-org-sync', f'{blind} new session(s) added to {act} — relaunch Claude to see them')


def cmd_rollback(ts):
    if os.path.basename(ts) != ts or ts.startswith('.'):
        raise Abort('invalid snapshot name')
    snap = os.path.join(BK, ts)
    man = json.load(open(os.path.join(snap, 'manifest.json')))
    pair = [(l, os.path.join(CCS, rel)) for l, rel in man['pair'].items()]
    dirs = {d for _, d in pair}
    man['ops'] = [r for r in man['ops'] if not r.get('skipped')]  # never written, never reverted
    for r in man['ops']:
        if os.path.dirname(r['path']) not in dirs or not re.fullmatch(r'(local_[0-9a-zA-Z-]+|scheduled-tasks)\.json',
                                                                        os.path.basename(r['path'])):
            raise Abort('manifest path outside the paired index dirs — rollback refused')
        if os.path.basename(r['path']) == TASKS:  # Desktop would ignore, then overwrite, the active org's file
            act = active_org(pair)
            if act is None or os.path.dirname(r['path']) == dict(pair)[act]:
                raise Abort(f'{TASKS} of the active org (or active org unknown) — switch orgs, then roll back')
    lock()
    with open(BLOCKED, 'w') as f:  # first: no sync may re-apply what we are undoing
        f.write(f'rolling back {ts}')
    wait_quiet(pair)
    todo = []
    for r in man['ops']:  # classify by current bytes (works after a crash mid-run too)
        cur = file_sha(r['path'])
        if cur == r['sha256_after']:
            todo.append(r)                      # applied -> revert
        elif cur != r['sha256_before']:         # neither ours nor the original: changed since
            raise Abort(f'{os.path.basename(r["path"])[:20]} changed since snapshot {ts} — rollback refused')
    for r in todo:
        if r['op'] == 'UPD' and sha(open(os.path.join(snap, r['backup']), 'rb').read()) != r['sha256_before']:
            raise Abort(f'backup of {os.path.basename(r["path"])[:20]} is corrupt — rollback refused, nothing written')
    parked = os.path.join(snap, 'rolled-back-created')
    for r in todo:
        if file_sha(r['path']) != r['sha256_after']:  # re-check right before each write
            raise Abort(f'{os.path.basename(r["path"])[:20]} changed during rollback — stopped')
        if r['op'] == 'UPD':
            atomic_write(r['path'], open(os.path.join(snap, r['backup']), 'rb').read(), r['sha256_before'])
        else:  # created by us: move aside into the snapshot, never delete
            os.makedirs(parked, exist_ok=True)
            shutil.move(r['path'], os.path.join(parked, os.path.basename(r['path'])))
    man['status'] = 'rolled-back'
    write_manifest(snap, man)
    with open(BLOCKED, 'w') as f:
        f.write(f'rolled back {ts}')
    log(f'rollback snapshot={ts} files={len(todo)} result=ok (sync now blocked; `unblock` to resume)')
    print(f'rolled back {len(todo)} file(s); sync blocked until `ccd-org-sync unblock`')


def file_sha(p):
    return sha(open(p, 'rb').read()) if os.path.exists(p) else None


def cmd_status(pair):
    for label, d in pair:
        n = len(glob.glob(os.path.join(d, 'local_*.json')))
        t = read_tasks(os.path.join(d, TASKS))
        print(f'{label:>6}: {n:4} entries  {len(t[1]["scheduledTasks"]) if t else 0:3} tasks  {os.path.relpath(d, CCS)}')
    print('tasks run in:', active_org(pair) or 'unknown (switching?)')
    print('blocked:', open(BLOCKED).read().strip() if os.path.exists(BLOCKED) else 'no')
    if os.path.exists(TASKS_HELD):
        print('tasks held:', open(TASKS_HELD).read())
    if os.path.exists(CONFLICTS):
        print('skipped conflicts:', open(CONFLICTS).read().replace('\n', ' '))
    if os.path.exists(LOG):
        print(''.join(open(LOG).readlines()[-5:]), end='')


def main(argv):
    args = argv[1:]
    if not args or args[0] in ('-h', '--help'):
        print(__doc__); return 0
    spec = os.environ.get('CCD_PAIR', '')
    if '--pair' in args:
        spec = args[args.index('--pair') + 1]
    cmd = args[0]
    try:
        os.makedirs(BK, exist_ok=True)
        if cmd == 'unblock':
            if os.path.exists(BLOCKED):
                os.unlink(BLOCKED)
            print('unblocked'); return 0
        if cmd == 'rollback':
            cmd_rollback(args[1]); return 0
        pair = parse_pair(spec)
        if cmd == 'sync':
            cmd_sync(args[1:], pair); return 0
        if cmd == 'status':
            cmd_status(pair); return 0
        print(f'unknown command {cmd}', file=sys.stderr); return 2
    except Blocked as e:  # already notified/logged once; stay quiet on every trigger
        print(f'ABORT: {e}', file=sys.stderr)
        return 1
    except Abort as e:
        log(f'{cmd} ABORT {e}')
        print(f'ABORT: {e}', file=sys.stderr)
        return 1
    except Exception as e:  # unexpected (e.g. a file vanished): fail closed, log the type only
        log(f'{cmd} ERROR {type(e).__name__}')
        print(f'ERROR: {type(e).__name__}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
